<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/2.6" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/2.6 https://diggsml.org/schemas/2.6/Diggs.xsd" gml:id="direction">
    <gml:description>Codes for the direction a geosynthetic's stiffness, strength, tension or installed orientation is stated in - machine, cross-machine, or isotropic. Shared vocabulary between the design value (diggs:GeosyntheticLayerDesignType/diggs:direction) and the as-built value (diggs:GeosyntheticType/diggs:direction) so an installed layer's stated orientation can be compared against the design value that governs it - same pattern as diggs:columnType (S6).</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/direction.xml</gml:identifier>
    <gml:name>DIGGS Geosynthetic Direction Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="machine">
            <gml:description>The direction of manufacture (roll) of the geosynthetic.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/direction.xml#machine</gml:identifier>
            <gml:name>Machine direction</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:GeosyntheticLayerDesign/diggs:direction</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:Geosynthetic/diggs:direction</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="cross_machine">
            <gml:description>The direction perpendicular to the machine direction.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/direction.xml#cross_machine</gml:identifier>
            <gml:name>Cross-machine direction</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:GeosyntheticLayerDesign/diggs:direction</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:Geosynthetic/diggs:direction</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="isotropic">
            <gml:description>The geosynthetic's relevant property does not vary significantly with direction.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/direction.xml#isotropic</gml:identifier>
            <gml:name>Isotropic</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:GeosyntheticLayerDesign/diggs:direction</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:Geosynthetic/diggs:direction</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
