<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/3" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/3 https://diggsml.org/schemas/3.0.0/Diggs.xsd" gml:id="elapsedTimeBasis">
    <gml:description>Codes naming which pair of timestamps an elapsed-time requirement is measured between, for the value of elapsedTimeBasis on diggs:ClearanceConstraint. Without this, &quot;elapsed time between two activities&quot; is ambiguous between several different intervals that can differ by the full duration of either activity.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/elapsedTimeBasis.xml</gml:identifier>
    <gml:name>DIGGS Elapsed Time Reference Basis Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="completion_to_start">
            <gml:description>Elapsed time measured from the completion of the first activity's governing interval to the start of the second's.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/elapsedTimeBasis.xml#completion_to_start</gml:identifier>
            <gml:name>Completion to start</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:ClearanceConstraint/diggs:elapsedTimeBasis</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="start_to_start">
            <gml:description>Elapsed time measured between the start of each activity's governing interval.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/elapsedTimeBasis.xml#start_to_start</gml:identifier>
            <gml:name>Start to start</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:ClearanceConstraint/diggs:elapsedTimeBasis</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="completion_to_completion">
            <gml:description>Elapsed time measured between the completion of each activity's governing interval.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/elapsedTimeBasis.xml#completion_to_completion</gml:identifier>
            <gml:name>Completion to completion</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:ClearanceConstraint/diggs:elapsedTimeBasis</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="start_to_completion">
            <gml:description>Elapsed time measured from the start of the first activity's governing interval to the completion of the second's.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/elapsedTimeBasis.xml#start_to_completion</gml:identifier>
            <gml:name>Start to completion</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:ClearanceConstraint/diggs:elapsedTimeBasis</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
