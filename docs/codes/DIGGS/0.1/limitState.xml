<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/2.6" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/2.6 https://diggsml.org/schemas/2.6/Diggs.xsd" gml:id="limitState">
    <gml:description>Codes for the Eurocode limit-state classification a design quantity is computed under - serviceability (SLS) or ultimate (ULS). Used for the value of diggs:GeoUnitDesignQuantityType/diggs:limitState.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/limitState.xml</gml:identifier>
    <gml:name>DIGGS Limit State Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="sls">
            <gml:description>The limit state concerned with normal function, comfort, and appearance under expected service loading - governs, for example, neutralPlaneDepth and maxAxialForceAtNeutralPlane.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/limitState.xml#sls</gml:identifier>
            <gml:name>Serviceability limit state (SLS)</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:GeoUnitDesignQuantity/diggs:limitState</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="uls">
            <gml:description>The limit state concerned with safety against collapse or other forms of structural or geotechnical failure under factored loading.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/limitState.xml#uls</gml:identifier>
            <gml:name>Ultimate limit state (ULS)</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:GeoUnitDesignQuantity/diggs:limitState</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
