<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/2.6" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/2.6 https://diggsml.org/schemas/2.6/Diggs.xsd" gml:id="loadTestReferenceSystem">
    <gml:description>Codes classifying how movement was referenced during a load test. Used for the value of diggs:AbstractLoadTestProcedureType/referenceSystem (StaticLoadTest, RapidLoadTest and DynamicLoadTest). Both ASTM D1143/D1143M and EN ISO 22477-1 require the reference system to be independent of the reaction system and unaffected by ground movement caused by the test; this dictionary records which arrangement was used, not that it satisfied the requirement.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/loadTestReferenceSystem.xml</gml:identifier>
    <gml:name>DIGGS Load Test Reference System Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="independent_reference_beam">
            <gml:description>Displacement measured against a fixed reference beam supported clear of the reaction system and of any ground disturbed by the test.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/loadTestReferenceSystem.xml#independent_reference_beam</gml:identifier>
            <gml:name>Independent Reference Beam</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:StaticLoadTest/diggs:referenceSystem</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:RapidLoadTest/diggs:referenceSystem</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DynamicLoadTest/diggs:referenceSystem</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="optical_survey">
            <gml:description>Displacement measured by optical or total-station survey referenced to a fixed benchmark independent of the reaction system.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/loadTestReferenceSystem.xml#optical_survey</gml:identifier>
            <gml:name>Optical Survey</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:StaticLoadTest/diggs:referenceSystem</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:RapidLoadTest/diggs:referenceSystem</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DynamicLoadTest/diggs:referenceSystem</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="satellite_positioning">
            <gml:description>Displacement measured by real-time GNSS/satellite positioning referenced to a fixed benchmark.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/loadTestReferenceSystem.xml#satellite_positioning</gml:identifier>
            <gml:name>Satellite Positioning</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:StaticLoadTest/diggs:referenceSystem</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:RapidLoadTest/diggs:referenceSystem</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DynamicLoadTest/diggs:referenceSystem</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="other">
            <gml:description>A reference system other than an independent reference beam, optical survey, or satellite positioning.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/loadTestReferenceSystem.xml#other</gml:identifier>
            <gml:name>Other</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:StaticLoadTest/diggs:referenceSystem</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:RapidLoadTest/diggs:referenceSystem</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DynamicLoadTest/diggs:referenceSystem</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
