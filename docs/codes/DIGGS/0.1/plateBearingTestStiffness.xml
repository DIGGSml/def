<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/2.6" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/2.6 https://diggsml.org/schemas/2.6/Diggs.xsd" gml:id="plateBearingTestStiffness">
    <gml:description>Codes classifying whether the bearing plate used in a plate-bearing load test behaves as rigid or flexible under load. Used for the value of diggs:AbstractPlateBearingTestProcedureType/plateStiffness.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/plateBearingTestStiffness.xml</gml:identifier>
    <gml:name>DIGGS Plate Bearing Test Plate Stiffness Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="rigid">
            <gml:description>The plate is stiff enough, relative to the ground or platform it bears on, that it distributes load essentially uniformly and does not itself deflect appreciably under test load. The standard steel plate used in ASTM D1195/D1196 and DIN 18134.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/plateBearingTestStiffness.xml#rigid</gml:identifier>
            <gml:name>Rigid</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:PlateLoadTest/diggs:plateStiffness</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:ZoneLoadTest/diggs:plateStiffness</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="flexible">
            <gml:description>The plate deflects appreciably under test load, so the bearing pressure it transmits is not uniform across its area.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/plateBearingTestStiffness.xml#flexible</gml:identifier>
            <gml:name>Flexible</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:PlateLoadTest/diggs:plateStiffness</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:ZoneLoadTest/diggs:plateStiffness</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
