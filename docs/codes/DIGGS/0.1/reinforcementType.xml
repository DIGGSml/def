<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/2.6" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/2.6 https://diggsml.org/schemas/2.6/Diggs.xsd" gml:id="reinforcementType">
    <gml:description>Codes for the configuration of steel reinforcement occupying an interval of a rigid inclusion column - rebar cage, single central bar, structural steel section. Distinct from diggs:reinforcementType on diggs:GeosyntheticLayerDesignType (geosynthetic product form) despite the shared element name - a different object, a different vocabulary. Used for the value of diggs:ReinforcementType/diggs:reinforcementType.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/reinforcementType.xml</gml:identifier>
    <gml:name>DIGGS Rigid Inclusion Reinforcement Arrangement Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="rebar_cage">
            <gml:description>A cylindrical cage of longitudinal bars and transverse spiral or hoop reinforcement.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/reinforcementType.xml#rebar_cage</gml:identifier>
            <gml:name>Rebar cage</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:Reinforcement/diggs:reinforcementType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="single_central_bar">
            <gml:description>A single steel bar placed on the column's centerline.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/reinforcementType.xml#single_central_bar</gml:identifier>
            <gml:name>Single central bar</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:Reinforcement/diggs:reinforcementType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="structural_steel_section">
            <gml:description>A rolled or fabricated structural steel section (for example an H-pile section) embedded in the column.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/reinforcementType.xml#structural_steel_section</gml:identifier>
            <gml:name>Structural steel section</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:Reinforcement/diggs:reinforcementType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
