<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/2.6" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/2.6 https://diggsml.org/schemas/2.6/Diggs.xsd" gml:id="relationType">
    <gml:description>Codes for which load-transfer mechanism a diggs:LoadTransferRelation governs - shaft (t-z) or tip (q-z). Mandatory. Used for the value of diggs:LoadTransferRelationType/diggs:relationType.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/relationType.xml</gml:identifier>
    <gml:name>DIGGS Load Transfer Relation Type Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="shaft_t_z">
            <gml:description>The shaft load-transfer relation - mobilised shaft shear stress versus relative shaft/soil displacement.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/relationType.xml#shaft_t_z</gml:identifier>
            <gml:name>Shaft (t-z)</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:LoadTransferRelation/diggs:relationType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="tip_q_z">
            <gml:description>The tip (base) load-transfer relation - mobilised unit tip resistance versus tip displacement.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/relationType.xml#tip_q_z</gml:identifier>
            <gml:name>Tip (q-z)</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:LoadTransferRelation/diggs:relationType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
