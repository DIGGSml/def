<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/2.6" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/2.6 https://diggsml.org/schemas/2.6/Diggs.xsd" gml:id="representativeValue">
    <gml:description>Codes for which representative value of an action magnitude is stated - characteristic, factored/design, or quasi-permanent, per EC7/BS EN 1990. Used for the value of diggs:DesignActionType/diggs:representativeValue.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/representativeValue.xml</gml:identifier>
    <gml:name>DIGGS Design Action Representative Value Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="characteristic">
            <gml:description>The unfactored value of an action as specified, before any partial factor is applied (EC7/BS EN 1990).</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/representativeValue.xml#characteristic</gml:identifier>
            <gml:name>Characteristic value</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DesignAction/diggs:representativeValue</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="design_factored">
            <gml:description>The characteristic value multiplied by its partial safety factor, used directly in an ultimate limit state check.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/representativeValue.xml#design_factored</gml:identifier>
            <gml:name>Design (factored) value</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DesignAction/diggs:representativeValue</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="quasi_permanent">
            <gml:description>The value of a variable action taken as its long-duration average, used in serviceability and long-term checks (EC7/BS EN 1990).</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/representativeValue.xml#quasi_permanent</gml:identifier>
            <gml:name>Quasi-permanent value</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DesignAction/diggs:representativeValue</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
